{
  "name": "dsh-fuse",
  "version": "1.3.0",
  "description": "dsh-fuse v1.3.0：UI 设计与代码规范一体化插件（设计令牌 + fence 页面级渲染 + 逐条就地微调 + 截图走查）。",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "spec-validator.mjs",
    "lib",
    "config",
    "cordis.patch.yml",
    "SKILL.md",
    "README.md",
    "README.en.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "check:client": "node scripts/build-client.mjs --check",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KLRSL/dsh-fuse.git"
  },
  "homepage": "https://github.com/KLRSL/dsh-fuse#readme",
  "bugs": {
    "url": "https://github.com/KLRSL/dsh-fuse/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ui",
    "fuse",
    "design-tokens",
    "code-style",
    "fence",
    "renderer"
  ]
}
