{
  "name": "dsh-fuse",
  "version": "2.0.3",
  "description": "dsh-fuse：只做一件事——把 dsh-fuse 围栏渲染成页面级 UI（三态兜底 + 一键导出 HTML + 宽度切换）。无设置页、无走查器、无预检工具。",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "spec.mjs",
    "lib",
    "config",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node tests/all.mjs"
  },
  "devDependencies": {
    "jsdom": "^25.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KLRSL/dsh-fuse.git"
  },
  "homepage": "https://github.com/KLRSL/dsh-fuse#readme",
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "ui", "fence", "renderer"]
}
