{
  "name": "dsh-fuse",
  "version": "1.2.1",
  "description": "Fuse v1.2.1 — UI 设计 + 代码规范一体化插件（ui-aesthetics 技能升级版）：设计令牌 theme.json（含品牌色单一事实来源）+ 代码规范 code-style.json + dsh-fuse fence 页面级渲染 + 走查器像素级微调 + 撤销历史 + 渲染状态回传（Spec valid≠Render correct）+ 通用适配流程与风格扩展；插件 UI 壳按功能设计语言（设计工作台/蓝紫）+ 深色模式适配（DSH 主题 dsw-alias 跟随，双通道探测）",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "config",
    "cordis.patch.yml",
    "SKILL.md",
    "README.md",
    "README.en.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.1-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KLRSL/dsh-fuse.git"
  },
  "homepage": "https://github.com/KLRSL/dsh-fuse#readme",
  "bugs": {
    "url": "https://github.com/KLRSL/dsh-fuse/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ui",
    "fuse",
    "design-tokens",
    "code-style",
    "fence",
    "renderer"
  ]
}
